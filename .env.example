# Local development database. In production, replace this with the libsql://
# URL returned by `turso db show --url YOUR_DATABASE_NAME`.
DATABASE_URL=file:.data/payload.db
# Required with a Turso DATABASE_URL. Generate it with
# `turso db tokens create YOUR_DATABASE_NAME`.
DATABASE_AUTH_TOKEN=
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Booking confirmation emails. Verify your sending domain in Resend, then use
# an address on that domain. onboarding@resend.dev is suitable only for testing.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Nutrihome
BOOKING_TIMEZONE=Asia/Kolkata

# Set all four to store new Media uploads in Cloudflare R2.
# Leave all four empty for local development storage.
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
